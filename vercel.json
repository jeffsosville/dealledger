{
  "rewrites": [
    {
      "source": "/removed",
      "destination": "/removed.html"
    },
    {
      "source": "/methodology",
      "destination": "/methodology.html"
    },
    {
      "source": "/writing",
      "destination": "/writing.html"
    },
    {
      "source": "/writing/:slug",
      "destination": "/writing/:slug.html"
    }
  ],
  "redirects": [
    {
      "source": "/why",
      "destination": "/methodology",
      "permanent": false
    },
    {
      "source": "/why.html",
      "destination": "/methodology",
      "permanent": false
    },
    {
      "source": "/writing/no-reason-to-fix",
      "destination": "/writing",
      "permanent": false
    },
    {
      "source": "/writing/no-reason-to-fix.html",
      "destination": "/writing",
      "permanent": false
    },
    {
      "source": "/pulse",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/pulse.html",
      "destination": "/",
      "permanent": false
    }
  ]
}
